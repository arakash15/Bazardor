# Use a strong random secret in production (at least 32 characters).
# Copy this file to .env and replace the placeholder values before running the app.
BETTER_AUTH_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

# Optional OAuth credentials. Configure callback URLs in each provider dashboard.
# Example local callback URLs:
# http://localhost:3000/api/auth/callback/google
# http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
